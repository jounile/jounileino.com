---
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/BlogHeader.astro';
import BlogPost from '../components/BlogPost.astro';
import Footer from '../components/Footer.astro';

const { title, description, publishDate, author, heroImage, permalink, alt } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} permalink={permalink} />
    <link rel="stylesheet" href="/blog.css" />
  </head>

  <body>
    <BlogHeader permalink={permalink} />
    <BlogPost title={title} description={description} author={author} heroImage={heroImage} publishDate={publishDate} alt={alt}>
      <slot />
    </BlogPost>
    <Footer />
  </body>
</html>
